# ClaudeLink Windows Host 配置示例
# 复制为 .env 后按需修改

# HTTP/WebSocket 服务端口
PORT=3000

# Claude Code 可执行文件路径
CLAUDE_CMD=C:\Users\YourName\.local\bin\claude.exe

# 访问令牌（可选，默认不启用）：
# - 不设置（或留空）时，令牌认证完全禁用：任何拿到地址的人都能直接控制终端
# - 设置后，所有 WebSocket 连接与 /api/status 接口都需要此令牌（?token= 或 Bearer）
# - 本机浏览器可先用 http://localhost:3000/?token=<令牌> 打开并自动保存
ACCESS_TOKEN=

# 是否启用 ngrok 公网隧道（true/false）
ENABLE_TUNNEL=false

# ngrok 区域（us/ap/eu/au/sa/jp/in）
NGROK_REGION=us

# ngrok 认证令牌（启用隧道时必填，https://dashboard.ngrok.com 获取）
NGROK_AUTHTOKEN=
