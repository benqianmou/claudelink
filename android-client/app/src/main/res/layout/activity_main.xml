<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0D12">

    <!-- 连接控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E2636">

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="192.168.1.100:3000"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3A4556"
            android:padding="12dp"
            android:textSize="14sp"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A90E2"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="24dp" />
    </LinearLayout>

    <!-- 终端显示区域 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F131C"
        android:padding="12dp"
        android:scrollbars="vertical">

        <com.claudelink.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <!-- 虚拟控制键区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#1A1F2E">

        <Button
            android:id="@+id/btnCtrlC"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Ctrl+C"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E74C3C"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnTab"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Tab"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34495E"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnEsc"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Esc"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34495E"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnUp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="↑"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2980B9"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnDown"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="↓"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2980B9"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="清屏"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7F8C8D"
            android:layout_margin="2dp" />
    </LinearLayout>

    <!-- 输入框区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E2636">

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入命令..."
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3A4556"
            android:padding="12dp"
            android:textSize="14sp"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:backgroundTint="#27AE60"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="24dp" />
    </LinearLayout>

</LinearLayout>
