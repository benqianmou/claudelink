<?xml version="1.0" encoding="utf-8"?>
<!--
  dark-saas 布局：近黑画布 #010102 / surface-1 输入槽与卡片 #0F1011 / primary 实底按钮 #5E6AD2 / 全 1px hairline 分隔线。
  控件全部显式声明 AppCompat 类，不依赖 Material 的 view-inflater（见 styles.xml 的主题注释）。
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_start">

    <!-- ───────── 主界面：顶栏 / 状态行 / 终端 / 按键区 / 输入栏 ───────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_start"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/boardButton"
                style="@style/IconButton"
                android:layout_marginEnd="8dp"
                android:contentDescription="任务看板"
                android:text="☰" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/serverInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="192.168.1.10:3000"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/connectButton"
                style="@style/PillButton"
                android:layout_marginStart="8dp"
                android:text="连接" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_start"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="○ 已断开"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            tools:text="● 已连接 · 2 客户端" />

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/terminal_bg"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <com.claudelink.TerminalView
                android:id="@+id/terminalView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 虚拟按键：上排方向/编辑键，下排控制键；带 tag 的由 bindKeys 绑定 keySeq -->
        <LinearLayout
            android:id="@+id/keyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_start"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="esc"
                    android:text="Esc" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="tab"
                    android:text="Tab" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="left"
                    android:text="←" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="up"
                    android:text="↑" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="down"
                    android:text="↓" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="right"
                    android:text="→" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="enter"
                    android:text="⏎" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="ctrlc"
                    android:text="^C" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/KeyButton"
                    android:tag="ctrld"
                    android:text="^D" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/fontDownButton"
                    style="@style/KeyButton"
                    android:text="A−" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/fontUpButton"
                    style="@style/KeyButton"
                    android:text="A＋" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/clearButton"
                    style="@style/KeyButton"
                    android:text="清屏" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/restartButton"
                    style="@style/KeyButton"
                    android:text="重启" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_start"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/inputField"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="输入命令…"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sendButton"
                style="@style/PillButton"
                android:layout_marginStart="8dp"
                android:text="发送" />
        </LinearLayout>
    </LinearLayout>

    <!-- ───────── 面板抽屉：连接区 + 历史地址 + 任务看板 ───────── -->
    <LinearLayout
        android:id="@+id/taskBoard"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/canvas_alt"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="面板"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/taskCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 连接区：地址 / 状态（含客户端数）/ 断开-重连 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/panelAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="未连接"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/panelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="○ 已断开"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/panelActionButton"
                style="@style/PillButton"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="连接" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="历史地址"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/panelHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:paddingStart="8dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="4dp"
                    android:text="进行中"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/activeTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:paddingStart="8dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="4dp"
                    android:text="已完成"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/taskHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/clearHistoryButton"
                    style="@style/KeyButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0"
                    android:text="清空看板历史" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
